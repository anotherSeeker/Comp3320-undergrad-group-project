{
    "version": 8,
    "configurePresets": [
        {
            "name": "gcc_mingw64_base",
            "hidden": true,
            "description": "Using compilers: C = C:\\msys64\\mingw64\\bin\\gcc.exe, CXX = C:\\msys64\\mingw64\\bin\\g++.exe",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "MinGW Makefiles",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
                "BUILD_SANDBOX": "ON"
            }
        },
        {
            "name": "gcc_mingw64_debug",
            "displayName": "sandbox debug (mingw64)",
            "inherits": [
                "gcc_mingw64_base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gcc_mingw64_dev",
            "displayName": "sandbox dev (mingw64)",
            "inherits": [
                "gcc_mingw64_base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "gcc_mingw64_release",
            "displayName": "sandbox release (mingw64)",
            "inherits": [
                "gcc_mingw64_base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "gcc_mingw64_debug_runtime",
            "displayName": "runtime debug (mingw64)",
            "inherits": [
                "gcc_mingw64_debug"
            ],
            "cacheVariables": {
                "BUILD_SANDBOX": "OFF"
            }
        },
        {
            "name": "gcc_mingw64_dev_runtime",
            "displayName": "runtime dev (mingw64)",
            "inherits": [
                "gcc_mingw64_dev"
            ],
            "cacheVariables": {
                "BUILD_SANDBOX": "OFF"
            }
        },
        {
            "name": "gcc_mingw64_release_runtime",
            "displayName": "runtime release (mingw64)",
            "inherits": [
                "gcc_mingw64_release"
            ],
            "cacheVariables": {
                "BUILD_SANDBOX": "OFF"
            }
        }
    ]
}